{
  "name": "dsh-reader",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Reading workspace with concept cards for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "linkedom": "^0.18.15",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "eval": "node eval/run.mjs",
    "build": "node scripts/build-client.mjs",
    "migrate:rehearsal": "node scripts/migrate-rehearsal.mjs",
    "release:check": "node scripts/release-check.mjs",
    "make:demo": "node scripts/make-demo-epub.mjs",
    "eval:visual": "node eval/visual.mjs"
  }
}
