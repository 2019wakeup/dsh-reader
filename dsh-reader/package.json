{
  "name": "@2019wakeup/dsh-reader",
  "version": "0.14.0",
  "type": "module",
  "description": "Reading workspace with concept cards and in-reader conversation for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "LICENSE",
    "icon.svg",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "linkedom": "^0.18.15",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "eval": "node eval/run.mjs",
    "build": "node scripts/build-client.mjs",
    "migrate:rehearsal": "node scripts/migrate-rehearsal.mjs",
    "release:check": "node scripts/release-check.mjs",
    "make:demo": "node scripts/make-demo-epub.mjs",
    "eval:visual": "node eval/visual.mjs",
    "eval:layout": "node eval/layout-host.mjs",
    "market:build": "node scripts/build-market-index.mjs",
    "market:verify": "node scripts/verify-market-index.mjs",
    "publish:check": "node scripts/publish-check.mjs",
    "eval:motion": "node eval/motion.mjs",
    "eval:docx": "node eval/docx.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "license": "MIT",
  "author": "2019wakeup",
  "homepage": "https://github.com/2019wakeup/dsh-reader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2019wakeup/dsh-reader.git",
    "directory": "dsh-reader"
  },
  "bugs": {
    "url": "https://github.com/2019wakeup/dsh-reader/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "reader",
    "pdf",
    "epub",
    "markdown",
    "reading",
    "annotations"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  }
}
